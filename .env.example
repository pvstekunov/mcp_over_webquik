# Optional: override webQUIK host (default webquik.sberbank.ru)
# WEBQUIK_HOST=webquik.sberbank.ru

# SSL: path to Sber/Russian CA bundle if cert verification fails
# WEBQUIK_CA_BUNDLE=/path/to/sberca-chain.pem

# SSL: set to false to disable verification (not recommended)
# WEBQUIK_SSL_VERIFY=false

# MCP HTTP transport (for container / remote deployment)
# MCP_TRANSPORT=streamable-http
# MCP_HOST=0.0.0.0
# MCP_PORT=3001
